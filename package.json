{
  "name": "cmai-tracker",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "checks": "node scripts/run-checks.mjs",
    "checks:report": "node scripts/run-checks.mjs --push",
    "gen:cases": "node scripts/make-test-cases.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "prepare": "lefthook install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "mockup:align": "node scripts/mockup-align-check.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.6.5",
    "@tabler/icons-react": "3.50.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "lucide-react": "1.68.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
